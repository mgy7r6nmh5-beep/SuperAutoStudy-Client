# ============================================================
#  SuperAutoStudy — 仓库忽略规则
#
#  ⚠️ 重要：本文件承担「防止个人数据入库」的职责。
#  凡以 `_` 开头的文件/目录都是开发期临时产物（调试脚本、抓包
#  结果、数据库备份、诊断输出等），其中可能含账号、cookie、
#  课程数据，一律不入库。
# ============================================================

# ---------- 运行时 / 第三方（体积大，以安装包另行分发）----------
jdk8/
mysql57/
python/
maven/
m2repo/
dl/
gui/
gui_venv/

# ---------- 构建产物 ----------
app/target/
target/
dist-portable/
*.jar
*.class
*.exe
# 打安装包时从 dist-portable 拷过来的临时树（350 MB），打完就删
installer/SuperAutoStudy/

# ---------- Python 字节码 ----------
# ⚠️ 显式排除，别依赖 `_*` 的巧合匹配：.pyc 的 co_filename 内嵌编译时的
# 绝对路径（含 Windows 用户名），本仓库是公开的，绝不能入库。
__pycache__/
*.pyc
*.pyo
*.pyd

# ---------- 开发期临时文件（含个人数据，务必排除）----------
_*

# ---------- 日志 ----------
*.log
*.log.bak
logs/
run.err

# ---------- 本地配置与个人数据（严禁入库）----------
client/settings.json
client.log
client/_shot/
cookie*
*.cookie

# AI 配置里有 api_key，绝不能进仓库
app/ai-config.json
# 抓不到题时落下的原始页面（含课程名/题目，属于个人数据）
app/quiz-dump/

# ---------- 本地环境相关（含本机绝对路径 / 账号，严禁入库）----------
my.ini
settings.xml
使用说明.md
部署说明.md
console-shot.png

# ---------- 工具 / IDE ----------
.workbuddy-ai/
.arts/
.idea/
.vscode/
*.iml
*.swp

# ---------- 远程访问工具（私钥 / cookie / 本机配置，绝不能入库）----------
# 整个 tools/ 都不入库：里面有 classmate_key、dg.cookie、cloudflared 配置
# 等本机私密数据。之前只列了单个文件，但 git 会把 tools/ 整个当成新目录
# 加进来，漏网的 cookie 和日志照样会进公开仓库。
tools/

# ---------- 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store
